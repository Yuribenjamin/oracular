{
  "name": "oracular",
  "version": "0.4.0",
  "description": "On-device intent engine. Your app learns when the user is ready. Nothing leaves the device.",
  "keywords": [
    "oracular",
    "intent",
    "propensity",
    "on-device",
    "privacy",
    "bayesian",
    "behavior",
    "prediction"
  ],
  "license": "MIT",
  "author": "Ibrahim Ragab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuribenjamin/oracular.git"
  },
  "bugs": {
    "url": "https://github.com/Yuribenjamin/oracular/issues"
  },
  "homepage": "https://yuribenjamin.github.io/oracular/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oracular": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    },
    "./config.schema.json": "./schema/config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs && node scripts/smoke-cli.mjs",
    "size": "size-limit",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run size && npm run pack:check",
    "prepublishOnly": "npm run check",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
