{
  "name": "oracular",
  "version": "0.1.0",
  "description": "On-device intent engine. Your app learns when the user is ready. Nothing leaves the device.",
  "keywords": [
    "oracular",
    "intent",
    "propensity",
    "on-device",
    "privacy",
    "bayesian",
    "behavior",
    "prediction"
  ],
  "license": "MIT",
  "author": "Ibrahim Ragab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuribenjamin/oracular.git"
  },
  "bugs": {
    "url": "https://github.com/Yuribenjamin/oracular/issues"
  },
  "homepage": "https://github.com/Yuribenjamin/oracular#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "smoke": "node scripts/smoke.cjs && node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
